# ─── SafeRo Environment Configuration ───
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─── Application ───
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ─── PostgreSQL ───
DATABASE_URL=postgresql://safero:safero_dev@localhost:5432/safero
POSTGRES_USER=safero
POSTGRES_PASSWORD=safero_dev
POSTGRES_DB=safero
POSTGRES_PORT=5432

# ─── JWT Authentication ───
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ─── Razorpay (Test Mode) ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── ML Service ───
ML_SERVICE_URL=http://localhost:8000

# ─── Frontend ───
VITE_API_URL=http://localhost:3001
